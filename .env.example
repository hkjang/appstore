# AppStore reads exactly these four environment variables.
# PostgreSQL and optional Keycloak/AI services must be reachable inside the
# deployment network; their settings are managed from the Admin UI.
POSTGRES_DSN=postgres://appstore:replace-me@postgres.example.internal:5432/appstore?sslmode=require
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-the-base64-output-of-openssl-rand
